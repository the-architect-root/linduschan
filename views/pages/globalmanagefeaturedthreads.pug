extends ../layout.pug

block head
	title #{__('Featured Threads')}
	style.
		.featured-item {
			display: flex;
			align-items: center;
			padding: 10px;
			margin-bottom: 10px;
			background: var(--background-rest);
			border: 1px solid var(--box-border-color);
			border-radius: 4px;
		}
		.featured-item img {
			width: 50px;
			height: 50px;
			object-fit: cover;
			border-radius: 3px;
			margin-right: 15px;
		}
		.featured-item-info {
			flex: 1;
		}
		.featured-item-board {
			color: var(--subject-color);
			font-weight: bold;
		}
		.featured-item-title {
			font-weight: bold;
			margin: 3px 0;
		}
		.featured-item-meta {
			color: var(--alt-font-color);
			font-size: 12px;
		}
		.btn {
			padding: 8px 15px;
			background: var(--label-color);
			color: var(--font-color);
			border: none;
			border-radius: 3px;
			cursor: pointer;
		}
		.btn:hover {
			background: var(--link-hover);
		}
		.btn-danger {
			background: #c00;
		}
		.btn-danger:hover {
			background: #a00;
		}

block content
	h1.board-title #{__('Global Management')}
	br
	hr(size=1)
	h4.no-m-p #{__('Add Featured Thread')}:
	.form-wrapper.flexleft
		form.form-post(action=`/forms/featurethread`, enctype='application/x-www-form-urlencoded', method='POST')
			input(type='hidden' name='_csrf' value=csrf)
			.row
				.label #{__('Board')}
				select(name='board' required)
					option(value='') Select board
					each board in boards
						option(value=board._id) /#{board._id}/
			.row
				.label #{__('Thread ID (OP Post Number)')}
				input(type='number' name='threadId' placeholder='e.g. 12345' required)
			input(type='submit', value=__('Feature Thread'))
	if featuredThreads && featuredThreads.length > 0
		hr(size=1)
		h4.no-m-p #{__('Current Featured Threads')}:
		.form-wrapper.flexleft
			each thread in featuredThreads
				.featured-item
					- const thumbFile = thread.files && thread.files[0]
					if thumbFile
						img(src=`/${thread.board}/file/thumb/${thumbFile.hash}${thumbFile.thumbextension}` alt='')
					else
						img(src='/file/noimage.png' alt='')
					.featured-item-info
						.featured-item-board /#{thread.board}/
						.featured-item-title
							a(href=`/${thread.board}/thread/${thread.postId}.html`)= thread.subject || `Thread No.${thread.postId}`
						.featured-item-meta
							| #{thread.replyposts || 0} replies
					form(action='/forms/unfeaturethread' method='POST' style='margin-left: auto;')
						input(type='hidden' name='_csrf' value=csrf)
						input(type='hidden' name='board' value=thread.board)
						input(type='hidden' name='threadId' value=thread.postId)
						button.btn.btn-danger(type='submit') Remove
	else
		hr(size=1)
		p No featured threads yet.
