extends ../layout.pug
include ../mixins/boardtable.pug

block head
	title #{meta.siteName}

block content
	.table-container.flex-center.mt-2.text-center
		img.title-logo(src='/file/induschan-logo.png' alt='Induschan')
	.table-container.flex-center.mv-10
		table(style='max-width:600px')
			tr
				th Welcome to Induschan
			tr
				td
					| <strong>Induschan</strong> is an India-based imageboard for indians to share their thoughts and discuss their interests and lifestyle. Feel free to share your thoughts with fellow brothers, but remember to read the <a href="/rules.html">Rules</a> and the <a href="/faq.html">FAQ</a> before posting.
	.table-container.flex-center.mv-10.text-center
		img(src='/file/surf.png' alt='Surf the Kaliyuga' style='max-width: 200%; height: auto;')
	if recentPosts && recentPosts.length > 0
		.table-container.flex-center.mv-10
			table(style='max-width:600px')
				tr
					th(colspan=3) Latest Posts
				each post, i in recentPosts
					tr
						td
							a(href=`/${post.board}/thread/${post.thread ? post.thread : post.postId}.html#${post.postId}`)
								if post.subject
									| #{post.subject.substring(0,50)}#{post.subject.length > 50 ? '...' : ''}
								else if post.message && post.message.raw
									| #{post.message.raw.substring(0,50)}#{post.message.raw.length > 50 ? '...' : ''}
								else
									| /${post.board}/#{post.postId}
						td #{post.board}
						td
							- const postedDate = new Date(post.date);
							time.right.reltime(datetime=postedDate.toISOString()) #{postedDate.toLocaleString(pageLanguage, {hourCycle:'h23'})}
	.table-container.flex-center.mv-10.text-center
		table(style='max-width:600px')
			tr
				th(colspan=2) Site Statistics
			tr
				td Total Posts
				td #{localStats.posts}
			tr
				td Total Content
				td #{fileStats.count} files (#{fileStats.totalSizeString})
		if enableWebring === true && webringStats != null
			.table-container.flex-center.mv-10.text-center
				table(style='max-width:450px')
					tr
						th #{__('Webring Stats')}
					tr
						td
							pre.no-m-p
								| #{__('There are currently %s sites and %s boards in the known webring. Across all webring boards, %s posts have been made in the last hour, %s in total.', webringStats.sites, webringStats.total, webringStats.pph, webringStats.posts)}
