extends ../layout.pug

block head
	title= title
	style.
		/* Journal archive - theme aware */
		.journal-archive {
			background: var(--background-rest);
			min-height: 100vh;
			padding: 40px 20px;
			color: var(--font-color);
		}
		.journal-header {
			text-align: center;
			margin-bottom: 50px;
		}
		.journal-header h1 {
			font-family: 'Georgia', serif;
			font-size: 2.5rem;
			color: var(--subject-color);
			margin-bottom: 10px;
			letter-spacing: 2px;
		}
		.journal-header .subtitle {
			color: var(--alt-font-color);
			font-style: italic;
		}
		.new-journal-btn {
			display: inline-block;
			background: var(--background-highlighted);
			color: var(--font-color);
			padding: 12px 24px;
			border-radius: 4px;
			text-decoration: none;
			font-weight: bold;
			margin-bottom: 30px;
			border: 1px solid var(--border-color);
			transition: background 0.3s;
		}
		.new-journal-btn:hover {
			background: var(--post-link-hover);
		}
		.empty-state {
			text-align: center;
			padding: 60px 20px;
			color: var(--alt-font-color);
		}
		.empty-state h3 {
			color: var(--subject-color);
			font-family: 'Georgia', serif;
			margin-bottom: 15px;
		}
		.journal-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
			gap: 30px;
			max-width: 1200px;
			margin: 0 auto;
			padding: 0 20px;
		}
		.journal-book {
			position: relative;
			text-align: center;
			transition: transform 0.3s ease;
		}
		.journal-book:hover {
			transform: translateY(-8px);
		}
		.journal-book a {
			text-decoration: none;
			color: inherit;
			display: block;
		}
		.journal-cover {
			width: 180px;
			height: 260px;
			margin: 0 auto 15px;
			border-radius: 3px;
			box-shadow: 0 4px 15px rgba(0,0,0,0.3), 0 8px 25px rgba(0,0,0,0.2);
			position: relative;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			overflow: hidden;
		}
		.journal-cover-title {
			font-family: 'Georgia', serif;
			font-size: 1.1rem;
			font-weight: bold;
			color: #fff;
			text-align: center;
			padding: 20px;
			text-shadow: 0 2px 4px rgba(0,0,0,0.5);
			line-height: 1.3;
		}
		.journal-info {
			padding: 10px 0;
		}
		.journal-title {
			font-family: 'Georgia', serif;
			font-size: 1rem;
			color: var(--font-color);
			margin-bottom: 5px;
			line-height: 1.4;
		}
		.journal-meta {
			font-size: 0.85rem;
			color: var(--alt-font-color);
		}
		.journal-tags {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 5px;
			margin-top: 8px;
		}
		.journal-tag {
			font-size: 0.7rem;
			color: var(--subject-color);
			background: var(--background-highlighted);
			padding: 2px 8px;
			border-radius: 12px;
		}

block content
	.journal-archive
		.journal-header
			h1 Private Journal Archive
			p.subtitle A collection of thoughts, reflections, and writings
			
			a.new-journal-btn(href='/journals/new') + New Entry
		
		if journals && journals.length > 0
			.journal-grid
				each journal in journals
					.journal-book
						a(href=`/journals/${journal.slug}.html`)
							.journal-cover(style=journal.coverType === 'image' && journal.coverImage ? `background-image: url(${journal.coverImage}); background-size: cover;` : `background: ${journal.coverColor || '#2a3f5f'};`)
								if !journal.coverImage || journal.coverType !== 'image'
									span.journal-cover-title= journal.title
							.journal-info
								.journal-title= journal.title
								.journal-meta= new Date(journal.date).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
								if journal.tags && journal.tags.length > 0
									.journal-tags
										each tag in journal.tags
											span.journal-tag= tag
		else
			.empty-state
				h3 No journal entries yet
				p Start writing by clicking the button above.
