extends ../layout.pug

block head
	title= title
	style.
		.journal-entry {
			background: var(--background-rest);
			min-height: 100vh;
			padding: 40px 20px;
			color: var(--font-color);
		}
		.journal-nav {
			max-width: 800px;
			margin: 0 auto 30px;
		}
		.journal-nav a {
			color: var(--post-link-color);
			text-decoration: none;
		}
		.journal-nav a:hover {
			text-decoration: underline;
		}
		.journal-article {
			max-width: 800px;
			margin: 0 auto;
			background: var(--background-rest);
			padding: 50px;
			border-radius: 4px;
			border: 1px solid var(--border-color);
			box-shadow: 0 4px 20px rgba(0,0,0,0.1);
		}
		.journal-article-header {
			text-align: center;
			margin-bottom: 40px;
			padding-bottom: 30px;
			border-bottom: 1px solid var(--border-color);
		}
		.journal-article h1 {
			font-family: 'Georgia', serif;
			font-size: 2.5rem;
			color: var(--font-color);
			margin-bottom: 20px;
			line-height: 1.3;
		}
		.journal-article-meta {
			color: var(--alt-font-color);
			font-style: italic;
		}
		.journal-article-content {
			font-family: 'Georgia', serif;
			font-size: 1.15rem;
			line-height: 1.8;
			color: var(--font-color);
		}
		.journal-article-content p {
			margin-bottom: 1.5em;
			text-align: justify;
		}
		.journal-article-tags {
			margin-top: 40px;
			padding-top: 30px;
			border-top: 1px solid var(--border-color);
		}
		.journal-article-tags span {
			display: inline-block;
			color: var(--subject-color);
			margin-right: 15px;
			font-size: 0.9rem;
		}
		/* Lined page style - text aligns with lines */
		.journal-article-content.lined {
			background-image: repeating-linear-gradient(
				transparent,
				transparent 28px,
				var(--border-color) 28px,
				var(--border-color) 29px
			);
			background-attachment: local;
			line-height: 29px;
			padding-top: 2px;
		}
		.journal-article-content.lined p {
			margin-bottom: 29px;
			line-height: 29px;
		}
		/* Dotted page style */
		.journal-article-content.dotted {
			background-image: radial-gradient(
				var(--border-color) 1px,
				transparent 1px
			);
			background-size: 20px 28px;
			background-attachment: local;
			line-height: 28px;
		}
		.journal-article-content.dotted p {
			margin-bottom: 28px;
			line-height: 28px;
		}
		/* Poll styles */
		.journal-poll {
			margin-top: 40px;
			padding: 30px;
			background: var(--background-highlighted);
			border: 1px solid var(--border-color);
			border-radius: 4px;
		}
		.journal-poll h3 {
			margin-bottom: 20px;
			color: var(--font-color);
			font-family: 'Georgia', serif;
		}
		.poll-options {
			display: flex;
			flex-direction: column;
			gap: 10px;
			margin-bottom: 20px;
		}
		.poll-option {
			display: flex;
			align-items: center;
			padding: 12px 15px;
			background: var(--background-rest);
			border: 1px solid var(--border-color);
			border-radius: 4px;
			cursor: pointer;
			transition: all 0.2s;
		}
		.poll-option:hover {
			background: var(--post-link-hover);
			border-color: var(--post-link-color);
		}
		.poll-option input {
			margin-right: 10px;
		}
		.poll-results {
			display: flex;
			flex-direction: column;
			gap: 15px;
			margin-bottom: 20px;
		}
		.poll-result {
			display: flex;
			flex-direction: column;
			gap: 5px;
		}
		.poll-result-bar {
			display: flex;
			align-items: center;
			gap: 10px;
		}
		.poll-result-bar .bar {
			height: 24px;
			background: var(--subject-color);
			border-radius: 3px;
			min-width: 30px;
			display: flex;
			align-items: center;
			justify-content: flex-end;
			padding-right: 8px;
			font-size: 0.8rem;
			color: #fff;
		}
		.poll-result-info {
			display: flex;
			justify-content: space-between;
			font-size: 0.9rem;
			color: var(--alt-font-color);
		}
		.poll-vote-btn {
			background: var(--subject-color);
			color: #fff;
			border: none;
			padding: 10px 20px;
			border-radius: 4px;
			cursor: pointer;
			font-size: 1rem;
		}
		.poll-vote-btn:hover {
			opacity: 0.9;
		}
		.poll-vote-btn:disabled {
			background: var(--border-color);
			cursor: not-allowed;
		}
		.poll-message {
			padding: 10px;
			border-radius: 4px;
			margin-bottom: 15px;
		}
		.poll-message.success {
			background: #2e7d32;
			color: #fff;
		}
		.poll-message.error {
			background: #c62828;
			color: #fff;
		}
		.poll-total {
			text-align: center;
			color: var(--alt-font-color);
			font-size: 0.9rem;
			margin-top: 15px;
		}

block content
	.journal-entry
		.journal-nav
			a(href='/journals.html') ← Back to Archive
		
		.journal-article
			.journal-article-header
				h1= journal.title
				.journal-article-meta
					= new Date(journal.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })
					if journal.tags && journal.tags.length > 0
						span  · 
						= journal.tags.join(', ')
			
			.journal-article-content(class=journal.pageStyle || 'blank')
				!= journal.content
			
			if journal.description
				p.journal-description= journal.description
			
			if poll
				.journal-poll
					h3= poll.question
					
					if poll.hasVoted || pollResults
						// Show results
						.poll-results
							each result, idx in poll.results
								.poll-result
									.poll-result-info
										span= result.option
										span #{result.count} votes (#{result.percentage}%)
									.poll-result-bar
										.bar(style=`width: ${result.percentage}%`)
						.poll-total= poll.totalVotes + ' total votes'
						if poll.hasVoted
							p.poll-message.success You have already voted
					else
						// Show voting form
						form.poll-form(method='POST', action=`/journals/${journal.slug}/vote.html`)
							input(type='hidden', name='_csrf', value=csrf)
							.poll-options
								each option, idx in poll.options
									label.poll-option
										input(type='radio', name='option', value=idx, required)
										span= option
							button.poll-vote-btn(type='submit') Vote
			
			a.edit-link(href=`/journals/${journal.slug}/edit.html`) Edit Journal
