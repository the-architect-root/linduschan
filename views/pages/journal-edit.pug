extends ../layout.pug

block head
	title= title
	style.
		.journal-form {
			background: var(--background-rest);
			min-height: 100vh;
			padding: 40px 20px;
			color: var(--font-color);
		}
		.journal-form-container {
			max-width: 800px;
			margin: 0 auto;
			background: var(--background-rest);
			padding: 40px;
			border-radius: 4px;
			border: 1px solid var(--border-color);
		}
		.journal-form h1 {
			font-family: 'Georgia', serif;
			color: var(--subject-color);
			margin-bottom: 30px;
			text-align: center;
		}
		.form-group {
			margin-bottom: 25px;
		}
		.form-group label {
			display: block;
			margin-bottom: 8px;
			color: var(--font-color);
			font-size: 0.9rem;
			font-weight: bold;
		}
		.form-group input,
		.form-group textarea,
		.form-group select {
			width: 100%;
			padding: 12px;
			background: var(--background-rest);
			border: 1px solid var(--border-color);
			border-radius: 4px;
			color: var(--font-color);
			font-size: 1rem;
			font-family: inherit;
		}
		.form-group input:focus,
		.form-group textarea:focus,
		.form-group select:focus {
			outline: none;
			border-color: var(--post-link-color);
		}
		.form-group textarea {
			min-height: 400px;
			resize: vertical;
			line-height: 1.6;
		}
		.form-hint {
			font-size: 0.8rem;
			color: var(--alt-font-color);
			margin-top: 5px;
		}
		.form-actions {
			display: flex;
			gap: 15px;
			justify-content: center;
			margin-top: 30px;
		}
		.btn-primary {
			background: var(--background-highlighted);
			color: var(--font-color);
			padding: 12px 30px;
			border: 1px solid var(--border-color);
			border-radius: 4px;
			font-size: 1rem;
			font-weight: bold;
			cursor: pointer;
			transition: background 0.3s;
		}
		.btn-primary:hover {
			background: var(--post-link-hover);
		}
		.btn-secondary {
			background: transparent;
			color: var(--alt-font-color);
			padding: 12px 30px;
			border: 1px solid var(--border-color);
			border-radius: 4px;
			font-size: 1rem;
			cursor: pointer;
			text-decoration: none;
		}
		.btn-secondary:hover {
			border-color: var(--post-link-color);
			color: var(--font-color);
		}

block content
	.journal-form
		.journal-form-container
			h1 Edit Journal
			
			form(action=`/journals/${journal.slug}/edit.html`, method='POST')
				input(type='hidden', name='_csrf', value=csrf)
				
				.form-group
					label(for='editCode') Edit Code (Required) *
					input#editCode(type='password', name='editCode', required, placeholder='Enter the edit code you created')
					p.form-hint You must enter the correct edit code to save changes
				
				.form-group
					label(for='title') Title *
					input#title(type='text', name='title', value=journal.title, required)
				
				.form-group
					label(for='description') Description
					input#description(type='text', name='description', value=journal.description, placeholder='Brief description...')
				
				.form-group
					label(for='content') Content *
					textarea#content(name='content', required)= journal.content
				
				.form-group
					label(for='tags') Tags (comma separated)
					input#tags(type='text', name='tags', value=journal.tags ? journal.tags.join(', ') : '', placeholder='personal, reflection, ideas')
				
				.form-actions
					button.btn-primary(type='submit') Save Changes
					a.btn-secondary(href=`/journals/${journal.slug}.html`) Cancel
