extends ../layout.pug

block head
	title Rules

block content
	h1.board-title Rules
	.table-container.flex-center.mv-10
		table.table-body
			tr.table-row
				td
					p 1. No illegal content like cp
			tr.table-row
				td
					p 2. Doxxing : allowed
			tr.table-row
				td
					p 3. Spam flooding : mat kar lala
			tr.table-row
				td
					p 4. No malware/ virus distribution or face permanent ban
			tr.table-row
				td
					p 5. Copyright infringement : ki maa ki chut
			tr.table-row
				td
					p Simple. Not much rules at every step
			tr.table-row
				td
					p Having no censorship doesn't mean that it becomes a degenerate hole;
			tr.table-row
				td
					p Rather it trains the user to surf the wave of chaos than drown in it
			tr.table-row
				td
					p I hope you understood
			tr.table-row
				td
					p Thank you, have a nice day!
